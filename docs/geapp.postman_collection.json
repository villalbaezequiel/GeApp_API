{
  "info": {
    "name": "GEAPP API",
    "description": "Documentación + validación de la API de GEAPP.\n\nVariables: `baseUrl`. Pre-requisito: `npm run seed` (admin + padrón + elección + mesa demo).\nOrden: correr la colección completa (Runner / newman); los requests guardan token e ids en variables.\nAuth: `Authorization: Bearer <token>` (también se acepta `Token <token>`).\nErrores: JSON `{errors:{message,error}}` con status 401/403/422.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health / Election",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ping"
              ]
            },
            "description": "Healthcheck. 200 sin body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get active election",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/election/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "election"
              ]
            },
            "description": "Elección activa con categorías y partidos. Público. 422 si no hay elección activa."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const e = pm.response.json(); pm.test('has parties', () => pm.expect(e.scrutinycategories[0].scrutinyparties.length).to.be.above(0));",
                  "pm.collectionVariables.set('partyA', e.scrutinycategories[0].scrutinyparties[0].id); pm.collectionVariables.set('partyB', e.scrutinycategories[0].scrutinyparties[1].id);"
                ]
              }
            }
          ]
        }
      ]
    },
