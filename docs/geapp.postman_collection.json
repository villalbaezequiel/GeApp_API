              "mode": "raw",
              "raw": "{\n  \"nationalId\": \"{{ownerDni}}\",\n  \"phone\": \"+54-911-0000-0000\",\n  \"email\": \"fiscal@example.com\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created or already exists', () => pm.expect([200,422]).to.include(pm.response.code));"
