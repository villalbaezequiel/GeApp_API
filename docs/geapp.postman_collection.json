              ]
            },
            "description": "Login con DNI + password. Devuelve datos de usuario + JWT (60 días). Guarda token en {{ownerToken}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nationalId\": \"{{ownerDni}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('ownerToken', pm.response.json().token);",
                  "pm.test('token present', () => pm.expect(pm.collectionVariables.get('ownerToken')).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('ownerId', pm.response.json().id);",
                  "pm.test('isOwner true', () => pm.expect(pm.response.json().isOwner).to.eql(true));"
                ]
              }
            }
